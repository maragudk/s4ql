# The corpus of SQL statements is read line by line, and a carriage return in a line is an error, so
# its files keep line feeds on every checkout.
/internal/sql/corpus/*.txt text eol=lf

# The generated corpus is large, and is reviewed through the tool that writes it.
/internal/sql/corpus/tcl.txt linguist-generated=true -diff
/internal/sql/corpus/doc.txt linguist-generated=true -diff
/internal/sql/corpus/fuzz.txt linguist-generated=true -diff

# SQLite's grammar, copied unchanged from its source archive by internal/sql/corpus/update.
/internal/sql/parser/testdata/parse.y linguist-vendored=true text eol=lf
